{
  "name": "quantflow-frontend",
  "private": true,
  "version": "2026.8.29",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.vue --fix",
    "lint:styles": "stylelint \"src/**/*.{vue,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --ui --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.0",
    "@vue-flow/controls": "^1.1.0",
    "@vue-flow/core": "^1.40.0",
    "@vue-flow/minimap": "^1.5.0",
    "@wailsio/runtime": "^3.0.0-alpha.94",
    "echarts": "^5.5.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.5",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-echarts": "^7.0.0",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^25.0.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0"
  }
}
